# Create a .env file next to this file and paste your key.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: enables Claude models in the model picker.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: choose a model available to your OpenAI project.
OPENAI_MODEL=gpt-4.1-mini

# Optional: port for the local web app.
PORT=3000
